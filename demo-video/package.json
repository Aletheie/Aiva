{
  "name": "aiva-application-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Editable 20-second demonstration using real AIVA application recordings.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "render": "remotion render src/index.ts AivaDemo aiva-demo.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-bitrate=320k",
    "postrender": "node tools/finalize-export.mjs",
    "thumbnail": "remotion still src/index.ts AivaDemo aiva-thumbnail.png --frame=477",
    "gif": "node tools/export-gif.mjs",
    "narration": "node tools/generate-narration.mjs --master",
    "narration:plan": "node tools/generate-narration.mjs --dry-run",
    "narration:voices": "node tools/generate-narration.mjs --list-voices",
    "narration:master": "node tools/master-narration.mjs",
    "music": "python3 tools/generate-demo-music.py",
    "compositions": "remotion compositions src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
